{
  "name": "aftereffects-mcp",
  "version": "2.6.4",
  "description": "MCP server for Adobe After Effects: let Claude, Cursor and any AI agent build, animate, check and render compositions",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspace server",
    "lint": "npm run lint --workspace server",
    "test": "npm run test --workspace server",
    "gen-docs": "npm run gen-docs --workspace server",
    "smoke": "npm run smoke --workspace server",
    "mock-bridge": "npm run mock-bridge --workspace server",
    "install-bridge": "npm run install-bridge --workspace server",
    "start": "npm run start --workspace server"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "after-effects",
    "adobe-after-effects",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "claude",
    "claude-code",
    "ai-agent",
    "extendscript",
    "motion-graphics",
    "motion-design",
    "animation",
    "automation",
    "video",
    "keyframes"
  ],
  "homepage": "https://github.com/irfanabdulhameed/aftereffects-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irfanabdulhameed/aftereffects-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/irfanabdulhameed/aftereffects-mcp/issues"
  }
}
